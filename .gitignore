# --- caches, logs, editor / tool state ---
__pycache__/
*.pyc
*.log
.qmlls.ini
.claude/

# --- generated by quickshell/theme/apply.py (they live in ~/.config, never here) ---
kitty/theme-colors.conf
hypr/theme_colors.lua
hypr/hyprlock-colors.conf
fish/conf.d/theme-colors.fish
btop/themes/current.theme
bottom/
fastfetch/
hypremoji/

# --- proprietary fonts: install them yourself (see README) ---
quickshell/fonts/Monaco.ttf
quickshell/fonts/Charcoal.ttf

# --- personal ---
gtk-3.0/bookmarks

# --- anything with logins or tokens (Spotify's login lives in Quickshell's state dir anyway) ---
token.json
*.token
.env
*.env
**/spotify/config.json

# --- scratch ---
scratch/
tmp/

# --- GTK 4 theme links into ~/.local/share/themes (absolute, made by install.sh's GTK step) ---
gtk-4.0/gtk.css
gtk-4.0/assets
