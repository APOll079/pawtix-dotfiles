{
    "name": "Retro (quickshell, {{theme}})",
    "type": "light",
    "colors": {
        "foreground": "{{text}}",
        "descriptionForeground": "{{dark}}",
        "focusBorder": "{{select_bar}}",
        "errorForeground": "{{urgent}}",
        "widget.shadow": "#00000000",
        "selection.background": "{{select_bar}}",

        "editor.background": "{{highlight}}",
        "editor.foreground": "{{text}}",
        "editor.selectionBackground": "{{select_bar}}66",
        "editor.inactiveSelectionBackground": "{{select_bar}}33",
        "editor.lineHighlightBackground": "{{base}}",
        "editor.lineHighlightBorder": "#00000000",
        "editorLineNumber.foreground": "{{dark}}",
        "editorLineNumber.activeForeground": "{{text}}",
        "editorCursor.foreground": "{{text}}",
        "editorWhitespace.foreground": "{{shadow}}",
        "editorIndentGuide.background1": "{{shadow}}",
        "editorGroup.border": "{{outline}}",
        "editorGroupHeader.tabsBackground": "{{base}}",
        "editorWidget.background": "{{base}}",
        "editorWidget.border": "{{outline}}",
        "editorSuggestWidget.selectedBackground": "{{select_bar}}",
        "editorSuggestWidget.selectedForeground": "{{select_text}}",

        "activityBar.background": "{{base}}",
        "activityBar.foreground": "{{text}}",
        "activityBar.inactiveForeground": "{{dark}}",
        "activityBar.border": "{{outline}}",
        "activityBarBadge.background": "{{select_bar}}",
        "activityBarBadge.foreground": "{{select_text}}",

        "sideBar.background": "{{base}}",
        "sideBar.foreground": "{{text}}",
        "sideBar.border": "{{outline}}",
        "sideBarTitle.foreground": "{{text}}",
        "sideBarSectionHeader.background": "{{shadow}}",
        "sideBarSectionHeader.foreground": "{{text}}",

        "list.activeSelectionBackground": "{{select_bar}}",
        "list.activeSelectionForeground": "{{select_text}}",
        "list.inactiveSelectionBackground": "{{shadow}}",
        "list.inactiveSelectionForeground": "{{text}}",
        "list.hoverBackground": "{{shadow}}",
        "list.focusBackground": "{{select_bar}}",
        "list.focusForeground": "{{select_text}}",
        "list.highlightForeground": "{{select_bar}}",

        "titleBar.activeBackground": "{{select_bar}}",
        "titleBar.activeForeground": "{{select_text}}",
        "titleBar.inactiveBackground": "{{shadow}}",
        "titleBar.inactiveForeground": "{{dark}}",
        "titleBar.border": "{{outline}}",
        "menu.background": "{{base}}",
        "menu.foreground": "{{text}}",
        "menu.selectionBackground": "{{select_bar}}",
        "menu.selectionForeground": "{{select_text}}",
        "menubar.selectionBackground": "{{select_bar}}",
        "menubar.selectionForeground": "{{select_text}}",

        "tab.activeBackground": "{{highlight}}",
        "tab.activeForeground": "{{text}}",
        "tab.inactiveBackground": "{{base}}",
        "tab.inactiveForeground": "{{dark}}",
        "tab.border": "{{outline}}",
        "tab.activeBorderTop": "{{select_bar}}",

        "statusBar.background": "{{base}}",
        "statusBar.foreground": "{{text}}",
        "statusBar.border": "{{outline}}",
        "statusBar.noFolderBackground": "{{base}}",
        "statusBar.debuggingBackground": "{{urgent}}",
        "statusBar.debuggingForeground": "{{outline}}",
        "statusBarItem.hoverBackground": "{{select_bar}}",

        "panel.background": "{{base}}",
        "panel.border": "{{outline}}",
        "panelTitle.activeForeground": "{{text}}",
        "panelTitle.inactiveForeground": "{{dark}}",
        "panelTitle.activeBorder": "{{select_bar}}",
        "terminal.background": "{{text}}",
        "terminal.foreground": "{{base}}",

        "button.background": "{{base}}",
        "button.foreground": "{{text}}",
        "button.hoverBackground": "{{shadow}}",
        "button.border": "{{outline}}",
        "input.background": "{{highlight}}",
        "input.foreground": "{{text}}",
        "input.border": "{{outline}}",
        "input.placeholderForeground": "{{dark}}",
        "inputOption.activeBorder": "{{select_bar}}",
        "dropdown.background": "{{highlight}}",
        "dropdown.foreground": "{{text}}",
        "dropdown.border": "{{outline}}",
        "badge.background": "{{select_bar}}",
        "badge.foreground": "{{select_text}}",
        "progressBar.background": "{{select_bar}}",
        "scrollbarSlider.background": "{{shadow}}",
        "scrollbarSlider.hoverBackground": "{{dark}}",
        "scrollbarSlider.activeBackground": "{{dark}}",
        "peekViewEditor.background": "{{base}}",
        "peekViewResult.background": "{{base}}",
        "peekViewTitle.background": "{{shadow}}",
        "notifications.background": "{{base}}",
        "notifications.foreground": "{{text}}",
        "notifications.border": "{{outline}}",
        "gitDecoration.modifiedResourceForeground": "{{syn_function}}",
        "gitDecoration.untrackedResourceForeground": "{{syn_string}}",
        "gitDecoration.deletedResourceForeground": "{{urgent}}"
    },
    "tokenColors": [
        { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "{{syn_comment}}", "fontStyle": "italic" } },
        { "scope": ["keyword", "storage", "storage.type", "keyword.control"], "settings": { "foreground": "{{syn_keyword}}" } },
        { "scope": ["string", "string.quoted", "markup.inline.raw"], "settings": { "foreground": "{{syn_string}}" } },
        { "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"], "settings": { "foreground": "{{syn_number}}" } },
        { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "{{syn_function}}" } },
        { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "{{syn_type}}" } },
        { "scope": ["variable", "variable.other"], "settings": { "foreground": "{{text}}" } },
        { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "{{dark}}" } },
        { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "{{syn_keyword}}", "fontStyle": "bold" } },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        { "scope": ["invalid"], "settings": { "foreground": "{{urgent}}" } }
    ]
}
