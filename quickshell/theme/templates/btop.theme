# Generated by quickshell/theme/apply.py from quickshell/theme/themes.json (theme: {{theme}}). Edit the template in quickshell/theme/templates/, not this file.
# Dark like the kitty theme: background is the theme text colour, foreground the base colour.

theme[main_bg]="{{text}}"
theme[main_fg]="{{base}}"
theme[title]="{{highlight}}"
theme[hi_fg]="{{accent}}"
theme[selected_bg]="{{outlineGradientFade}}"
theme[selected_fg]="{{highlight}}"
theme[inactive_fg]="{{shadow}}"
theme[graph_text]="{{shadow}}"
theme[meter_bg]="{{outlineGradientFade}}"
theme[proc_misc]="{{accent}}"
theme[cpu_box]="{{shadow}}"
theme[mem_box]="{{shadow}}"
theme[net_box]="{{shadow}}"
theme[proc_box]="{{shadow}}"
theme[div_line]="{{shadow}}"

theme[temp_start]="{{shadow}}"
theme[temp_mid]="{{accent}}"
theme[temp_end]="{{urgent}}"

theme[cpu_start]="{{shadow}}"
theme[cpu_mid]="{{accent}}"
theme[cpu_end]="{{urgent}}"

theme[free_start]="{{outlineGradientFade}}"
theme[free_mid]=""
theme[free_end]="{{shadow}}"

theme[cached_start]="{{outlineGradientFade}}"
theme[cached_mid]=""
theme[cached_end]="{{base}}"

theme[available_start]="{{outlineGradientFade}}"
theme[available_mid]=""
theme[available_end]="{{highlight}}"

theme[used_start]="{{accent}}"
theme[used_mid]=""
theme[used_end]="{{urgent}}"

theme[download_start]="{{outlineGradientFade}}"
theme[download_mid]="{{accent}}"
theme[download_end]="{{highlight}}"

theme[upload_start]="{{outlineGradientFade}}"
theme[upload_mid]="{{shadow}}"
theme[upload_end]="{{urgent}}"
